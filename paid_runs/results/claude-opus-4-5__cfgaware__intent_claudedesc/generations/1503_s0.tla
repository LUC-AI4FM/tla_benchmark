---------------------------- MODULE HOFilter ----------------------------

VARIABLES x

(***************************************************************************)
(* A generic set-filter operator that takes:                                *)
(*   - S: a set                                                             *)
(*   - P1(_): a unary predicate                                             *)
(*   - P2(_, _): a binary predicate                                         *)
(* Returns the subset of elements satisfying both predicates.               *)
(***************************************************************************)
Filter(S, P1(_), P2(_, _)) ==
    { e \in S : P1(e) /\ P2(e, TRUE) }

(***************************************************************************)
(* Unary predicate: element is greater than 1                               *)
(***************************************************************************)
GreaterThanOne(e) == e > 1

(***************************************************************************)
(* Binary predicate: element is odd and second argument is TRUE             *)
(***************************************************************************)
OddAndTrue(e, b) == (e % 2 = 1) /\ b

(***************************************************************************)
(* The set to filter                                                        *)
(***************************************************************************)
BaseSet == {1, 2, 3, 4, 5}

(***************************************************************************)
(* Apply the filter with higher-order operator arguments                    *)
(***************************************************************************)
FilteredSet == Filter(BaseSet, GreaterThanOne, OddAndTrue)

(***************************************************************************)
(* Initialize x to a value from the filtered set                            *)
(* FilteredSet should be {3, 5} (elements > 1 that are odd)                 *)
(***************************************************************************)
Init == x \in FilteredSet

(***************************************************************************)
(* The system remains static with no state changes                          *)
(***************************************************************************)
Next == UNCHANGED x

=============================================================================