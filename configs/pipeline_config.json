{
  "pipeline_stages": [
    "preference_generation",
    "model_training",
    "model_evaluation",
    "metrics_computation"
  ],
  "preference_generation": {
    "num_candidates": 5,
    "conditions": [
      "nlp_to_tla",
      "v2_to_tla",
      "v3_to_tla"
    ],
    "validation_timeout_sany": 60,
    "validation_timeout_tlc": 300
  },
  "model_training": {
    "base_model": "deepseek-ai/DeepSeek-R1-Distill-Llama-8B",
    "beta": 0.1,
    "learning_rate": 1e-4,
    "num_epochs": 5,
    "batch_size": 4,
    "warmup_steps": 100,
    "max_length": 2048,
    "gradient_accumulation_steps": 4
  },
  "model_evaluation": {
    "compute_code_quality": true,
    "compute_codebleu": true,
    "compute_complexity_metrics": true
  },
  "metrics_computation": {
    "output_formats": [
      "csv",
      "json"
    ]
  }
}
