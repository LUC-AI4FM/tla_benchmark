[Unit]
Description=TLA+ Benchmark Dashboard
After=network.target redis-server.service

[Service]
Type=simple
User=arslanbisharat
WorkingDirectory=/home/arslanbisharat/Documents/AI4FM/tla bench dashboard
Environment=REDIS_URL=redis://localhost:6379
ExecStart=/usr/bin/python3 -m streamlit run workflow/dashboard.py \
    --server.port 8501 \
    --server.address 127.0.0.1 \
    --server.headless true \
    --server.enableCORS false \
    --server.enableXsrfProtection true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
