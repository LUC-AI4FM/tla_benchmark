---- MODULE TwoPhaseCommit ----
EXTENDS TLC, FiniteSets

CONSTANTS RM
ASSUME IsFiniteSet(RM) /\ RM /= {}

VARIABLES state

vars == <<state>>

\* The set of possible states for a Resource Manager (RM).
STATES == {"working", "prepared", "committed", "aborted"}

\* Type invariant: The state of each RM is one of the allowed states.
TypeOK == state \in [RM -> STATES]

\* --
\* Protocol Definition
\* --

\* Initially, all RMs are in the "working" state.
Init == state = [rm \in RM |-> "working"]

\* An RM in the "working" state can move to the "prepared" state.
\* This corresponds to the first phase of the protocol.
Prepare(rm) ==
    /\ state[rm] = "working"
    /\ state' = [state EXCEPT ![rm] = "prepared"]

\* An RM in the "prepared" state can decide to commit or abort.
\* This corresponds to the second phase of the protocol.
\* A commit decision is only possible if no RM has aborted.
\* An abort decision is only possible if no RM has committed.
\* This enforces that all RMs eventually make the same decision without
\* an explicit coordinator.
Decide(rm) ==
    /\ state[rm] = "prepared"
    /\ \/ (* Decide to commit *)
          /\ \A r \in RM : state[r] # "aborted"
          /\ state' = [state EXCEPT ![rm] = "committed"]
       \/ (* Decide to abort *)
          /\ \A r \in RM : state[r] # "committed"
          /\ state' = [state EXCEPT ![rm] = "aborted"]

\* The next state is generated by one RM taking a Prepare or Decide step.
Next == \E rm \in RM : Prepare(rm) \/ Decide(rm)

\* The complete safety specification of the protocol.
Spec == Init /\ [][Next]_vars

\* --
\* Properties / Invariants
\* --

\* Consistency invariant: It is never the case that one RM has committed
\* while another has aborted. This is the key safety property of 2PC.
Consistency ==
    ~( (\E r1 \in RM : state[r1] = "committed") /\
       (\E r2 \in RM : state[r2] = "aborted") )

\* The following theorems assert that the specification satisfies the invariants.
THEOREM Spec => []TypeOK
THEOREM Spec => []Consistency

=============================================================================