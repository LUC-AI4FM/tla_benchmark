------------------------------ MODULE SmallSpec ------------------------------
EXTENDS Naturals, Sequences

VARIABLES x, y, pc

(* ------------------------------------------------------------------ *)
(*  Variables set                                                     *)
vars == {x, y, pc}

(* ------------------------------------------------------------------ *)
(*  Initial state                                                      *)
Init ==
  /\ x = {"a", "b"}
  /\ y = <<1, 2, 3>>
  /\ pc = "Init"

(* ------------------------------------------------------------------ *)
(*  Placeholder for printing (does nothing)                           *)
PrintT(a,b) == TRUE

(* ------------------------------------------------------------------ *)
(*  Stuttering action after termination                              *)
Terminate ==
  /\ pc' = pc
  /\ x' = x
  /\ y' = y

(* ------------------------------------------------------------------ *)
(*  Next-state relation                                               *)
Next ==
  \/ (pc = "Init" 
      /\ x' = x \cup {"c"} 
      /\ y' = Subst(y, 2, 4)
      /\ PrintT(x', y')
      /\ pc' = "Done")
  \/ (pc = "Done" /\ Terminate)

(* ------------------------------------------------------------------ *)
(*  Specification                                                     *)
Spec == Init /\ [][Next]_vars

(* ------------------------------------------------------------------ *)
(*  Termination property                                             *)
Termination == <> (pc = "Done")

=============================================================================