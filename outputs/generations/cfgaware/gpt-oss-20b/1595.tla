------------------------------ MODULE Counter ------------------------------
EXTENDS Naturals

(* ------------------------------------------------------------------ *)
(* Constants and variables                                            *)
(* ------------------------------------------------------------------ *)

CONSTANT MaxCount == 10

VARIABLES pc, x

(* ------------------------------------------------------------------ *)
(* Initial state                                                      *)
(* ------------------------------------------------------------------ *)

Init ==
  /\ pc = "Loop"
  /\ x = 0

(* ------------------------------------------------------------------ *)
(* Next actions                                                       *)
(* ------------------------------------------------------------------ *)

Increment ==
  /\ pc = "Loop"
  /\ x < MaxCount
  /\ x' = x + 1
  /\ pc' = pc

DoneTransition ==
  /\ pc = "Loop"
  /\ x >= MaxCount
  /\ pc' = "Done"
  /\ x' = x

Next == Increment \/ DoneTransition

(* ------------------------------------------------------------------ *)
(* Specification with weak fairness on Next                           *)
(* ------------------------------------------------------------------ *)

Spec == Init /\ [][Next]_<<pc, x>> /\ WF_vars(Next)

(* ------------------------------------------------------------------ *)
(* Termination property: eventually we reach the terminal state      *)
(* ------------------------------------------------------------------ *)

Termination == <> (pc = "Done")

(* ------------------------------------------------------------------ *)
(* Auxiliary predicates                                               *)
(* ------------------------------------------------------------------ *)

AtFive ==
  x = 5

FinishLoop ==
  pc = "Done"

PossibleCounts ==
  /\ x \in 0..MaxCount

=============================================================================