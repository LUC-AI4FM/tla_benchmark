------------------------------ MODULE RegularRegisters ------------------------------
EXTENDS Naturals, Sequences

CONSTANTS N

VARIABLES x, y, pc

(* --------------------------------------------------------------------------- *)
(*  Type constraints for the variables                                       *)
(* --------------------------------------------------------------------------- *)
TypeOK == /\ N \in Nat
        /\ x \in [1..N -> SUBSET {0,1}]
        /\ y \in [1..N -> 0..1]
        /\ pc \in [1..N -> {0,1,2,3}]

(* --------------------------------------------------------------------------- *)
(*  Initial state                                                             *)
(* --------------------------------------------------------------------------- *)
Init == /\ TypeOK
       /\ x = [i \in 1..N |-> {0}]
       /\ y = [i \in 1..N |-> 0]
       /\ pc = [i \in 1..N |-> 0]

(* --------------------------------------------------------------------------- *)
(*  Helper: neighbor function                                                *)
(* --------------------------------------------------------------------------- *)
neighbor(i) == IF i < N THEN i + 1 ELSE 1

(* --------------------------------------------------------------------------- *)
(*  Actions of the algorithm                                                 *)
(* --------------------------------------------------------------------------- *)
WriteAdd(i) ==
  /\ pc[i] = 0
  /\ x' = [x EXCEPT ![i] = @ \cup {1}]
  /\ pc' = [pc EXCEPT ![i] = 1]
  /\ UNCHANGED << y >>

WriteCommit(i) ==
  /\ pc[i] = 1
  /\ x' = [x EXCEPT ![i] = {1}]
  /\ pc' = [pc EXCEPT ![i] = 2]
  /\ UNCHANGED << y >>

ReadNeighbor(i) ==
  /\ pc[i] = 2
  /\ y' = [y EXCEPT ![i] = CHOOSE v \in x[neighbor(i)]]
  /\ pc' = [pc EXCEPT ![i] = 3]
  /\ UNCHANGED << x >>

Next == ∃ i \in 1..N : WriteAdd(i) \/ WriteCommit(i) \/ ReadNeighbor(i)

(* --------------------------------------------------------------------------- *)
(*  Termination condition                                                    *)
(* --------------------------------------------------------------------------- *)
Term == ∀ i \in 1..N : pc[i] = 3

(* --------------------------------------------------------------------------- *)
(*  Safety property: if all processes are done, some y[i] equals 1           *)
(* --------------------------------------------------------------------------- *)
PCorrect == (∀ i \in 1..N : pc[i] = 3) => (∃ j \in 1..N : y[j] = 1)

(* --------------------------------------------------------------------------- *)
(*  Invariant used in the proof                                             *)
(* --------------------------------------------------------------------------- *)
Inv ==
  /\ ∀ i \in 1..N : pc[i] <= 2 => x[i] ⊆ {0,1}
  /\ ∀ i \in 1..N : pc[i] >= 3 => y[i] = 1

(* --------------------------------------------------------------------------- *)
(*  Specification                                                            *)
(* --------------------------------------------------------------------------- *)
Spec == Init /\ [][Next]_<<x,y,pc>> /\ TypeOK
=============================================================================