{
  "id": null,
  "Specification": "This module is a test specification for a graph utility library. It consists entirely of ASSUME statements that check expected behavior of imported graph operators such as SimplePath, AreConnectedIn, GraphUnion, IsBipartiteWithPartitions, IsDag, Successors, Predecessors, Ancestors, Descendants, Roots, and Leaves on a variety of small graphs. The file has no state variables, no actions, and no temporal behavior; instead it serves as a collection of static assertions over graph values and boolean results, with one INSTANCE of TLC used inside a LET expression to print a test banner.",
  "ModuleName": "GraphsTests",
  "ExtendsModules": [
    "Graphs",
    "TLCExt"
  ],
  "InstanceModules": [
    "TLC"
  ],
  "InstanceSubstitutions": [],
  "ConstantNames": [],
  "VariableNames": [],
  "AssumptionNames": [
    "LET T == INSTANCE TLC IN T!PrintT(\"GraphsTests\")",
    "AssertEq(SimplePath([edge|-> {}, node |-> {}]), {})",
    "AssertEq(SimplePath([edge|-> {}, node |-> {1,2,3}]), {<<1>>, <<2>>, <<3>>})",
    "AssertEq(SimplePath([edge|-> {<<1,2>>, <<2,3>>}, node |-> {1,2,3}]), \n            { <<1>>, <<2>>, <<3>>, <<1,2>>, <<2,3>>, <<1,2,3>> } )",
    "\\A g \\in Graphs({\"A\", \"B\", \"C\"}):\n    \\A u,v \\in g.node :\n        AreConnectedIn(u, v, g) \\in BOOLEAN",
    "LET G ==  [node |-> {1,2,3,4,5,6}, \n                  edge |-> {<<1,2>>, <<2,3>>, <<2,4>>, <<3,2>>, <<3,4>>, <<3,5>>, \n                            <<4,2>>, <<5,6>>, <<6,5>>}]\n       IN  \\A m,n \\in G.node : AreConnectedIn(m,n,G) <=> ConnectionsIn(G)[m,n]",
    "LET G == [node |-> {1, 2}, edge |-> {<<1, 2>>}]\n           H == [node |-> {2, 3}, edge |-> {<<2, 3>>}]\n       IN AssertEq(GraphUnion(G, H),\n                    [node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<2, 3>>}])",
    "LET G == [node |-> {1, 2, 3, 4},\n                 edge |-> {<<1, 2>>, <<2, 3>>, <<3, 4>>}]\n       IN AssertEq(IsBipartiteWithPartitions(G, {1, 3}, {2, 4}), TRUE)",
    "\\A g \\in Graphs({1, 2, 3}): IsDag(g) \\in BOOLEAN",
    "AssertEq(IsDag([node |-> {1, 2, 3, 4},\n                       edge |-> {<<1, 2>>, <<1, 3>>, <<2, 4>>, <<3, 4>>}]), TRUE)",
    "AssertEq(IsDag([node |-> {1},\n                       edge |-> {<<1, 1>>}]), FALSE)",
    "AssertEq(IsDag([node |-> {1, 2},\n                       edge |-> {<<1, 2>>, <<2, 1>>}]), FALSE)",
    "AssertEq(IsDag([node |-> {1, 2, 3},\n                       edge |-> {<<1, 2>>, <<2, 3>>, <<3, 1>>}]), FALSE)",
    "AssertEq(IsDag(EmptyGraph), TRUE)",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<1, 3>>}]\n       IN AssertEq(Successors(G, 1), {2, 3})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<1, 3>>}]\n       IN AssertEq(Successors(G, 2), {})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<1, 3>>}]\n       IN AssertEq(AllSuccessors(G, {1, 2}), {2, 3})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<1, 3>>}]\n       IN AssertEq(AllSuccessors(G, {2}), {})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<2, 1>>, <<3, 1>>}]\n       IN AssertEq(Predecessors(G, 1), {2, 3})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<2, 1>>, <<3, 1>>}]\n       IN AssertEq(Predecessors(G, 2), {})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<2, 1>>, <<3, 1>>}]\n       IN AssertEq(AllPredecessors(G, {1, 2}), {2, 3})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<2, 1>>, <<3, 1>>}]\n       IN AssertEq(AllPredecessors(G, {2}), {})",
    "LET G == [node |-> {1}, edge |-> {}]\n       IN AssertEq(Ancestors(G, 1), {})",
    "LET G == [node |-> {1, 2, 3, 4}, edge |-> {<<4, 2>>, <<2, 1>>, <<3, 1>>}]\n       IN AssertEq(Ancestors(G, 1), {2, 3, 4})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<2, 3>>, <<3, 1>>}]\n       IN AssertEq(Ancestors(G, 1), {1, 2, 3})",
    "AssertEq(Ancestors([node |-> {1, 2, 3, 4},\n                           edge |-> {<<1, 2>>, <<1, 3>>, <<2, 4>>, <<3, 4>>}], 4), {1, 2, 3})",
    "LET G == [node |-> {1}, edge |-> {}]\n       IN AssertEq(Descendants(G, 1), {})",
    "LET G == [node |-> {1, 2, 3, 4}, edge |-> {<<4, 2>>, <<2, 1>>, <<3, 1>>}]\n       IN AssertEq(Descendants(G, 4), {1, 2})",
    "LET G == [node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<2, 3>>, <<3, 1>>}]\n       IN AssertEq(Descendants(G, 1), {1, 2, 3})",
    "AssertEq(Descendants([node |-> {1, 2, 3, 4},\n                             edge |-> {<<1, 2>>, <<1, 3>>, <<2, 4>>, <<3, 4>>}], 1), {2, 3, 4})",
    "AssertEq(Roots([node |-> {1, 2, 3}, edge |-> {<<2, 1>>, <<3, 1>>}]), {2, 3})",
    "AssertEq(Roots([node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<1, 3>>}]), {1})",
    "AssertEq(Roots([node |-> {1, 2}, edge |-> {<<1, 2>>, <<2, 1>>}]), {})",
    "AssertEq(Leaves([node |-> {1, 2, 3}, edge |-> {<<2, 1>>, <<3, 1>>}]), {1})",
    "AssertEq(Leaves([node |-> {1, 2, 3}, edge |-> {<<1, 2>>, <<1, 3>>}]), {2, 3})",
    "AssertEq(Leaves([node |-> {1, 2}, edge |-> {<<1, 2>>, <<2, 1>>}]), {})"
  ],
