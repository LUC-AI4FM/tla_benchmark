{
  "id": null,
  "Specification": "This module is a test specification for JSON serialization and deserialization operators provided by imported modules, especially Json and TLCExt. It checks how primitive values, sets, tuples, functions, records, Cartesian products, subsets, ranges, and nested structures are converted to JSON strings or reconstructed from JSON files. It also includes negative tests asserting that serialization operators reject unsupported argument shapes with specific error messages, and it defines several helper operators for round-trip and file-based serialization checks using assumptions rather than temporal behavior.",
  "ModuleName": "JsonTests",
  "ExtendsModules": [
    "Json",
    "Integers",
    "Sequences",
    "TLC",
    "TLCExt"
  ],
  "InstanceModules": [],
  "InstanceSubstitutions": [],
