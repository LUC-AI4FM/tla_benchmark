    "ModelValueConstant"
  ],
  "VariableNames": [],
  "AssumptionNames": [
    "AssertEq(ToJsonArray({}), \"[]\")",
    "AssertEq(ToJsonArray(<<>>), \"[]\")",
    "AssertEq(ToJson(FALSE), \"false\")",
    "AssertEq(ToJson(1), \"1\")",
    "AssertEq(ToJson(\"a\"), \"\\\"a\\\"\")",
    "AssertEq(ToJson(ModelValueConstant), \"\\\"ModelValue\\\"\")",
    "AssertEq(ToJson({TRUE, FALSE}), \"[false,true]\")",
    "AssertEq(ToJson({1}), \"[1]\")",
    "AssertEq(ToJsonArray({TRUE, FALSE}), \"[false,true]\")",
    "AssertEq(ToJsonArray({1}), \"[1]\")",
    "AssertEq(ToJsonArray({\"foo\"}), \"[\\\"foo\\\"]\")",
    "AssertEq(ToJsonObject([a |-> TRUE, b |-> FALSE]), \"{\\\"a\\\":true,\\\"b\\\":false}\")",
    "AssertEq(ToJsonObject([a |-> 1]), \"{\\\"a\\\":1}\")",
    "AssertEq(ToJsonObject([a |-> \"b\"]), \"{\\\"a\\\":\\\"b\\\"}\")",
    "AssertEq(ToJson({3, 2, 1}), \"[1,2,3]\")",
    "AssertEq(ToJson(<<3, 2, 1>>), \"[3,2,1]\")",
    "AssertEq(ToJson([x \\in {3, 2, 1} |-> 2 * x + 1]), \"[3,5,7]\")",
    "AssertEq(ToJson(3 :> \"c\" @@ 2 :> \"b\" @@ 1 :> \"a\"), \"[\\\"a\\\",\\\"b\\\",\\\"c\\\"]\")",
    "AssertEq(ToJson([ {2, 1} -> {\"a\", \"b\"} ]), \"[[\\\"a\\\",\\\"a\\\"],[\\\"a\\\",\\\"b\\\"],[\\\"b\\\",\\\"a\\\"],[\\\"b\\\",\\\"b\\\"]]\")",
    "AssertEq(ToJson([ {1, 0} -> {\"a\", \"b\"} ]), \"[{\\\"0\\\":\\\"a\\\",\\\"1\\\":\\\"a\\\"},{\\\"0\\\":\\\"a\\\",\\\"1\\\":\\\"b\\\"},{\\\"0\\\":\\\"b\\\",\\\"1\\\":\\\"a\\\"},{\\\"0\\\":\\\"b\\\",\\\"1\\\":\\\"b\\\"}]\")",
    "AssertEq(ToJson([a: {2, 1}, b: {\"a\", \"b\"}]), \"[{\\\"a\\\":1,\\\"b\\\":\\\"a\\\"},{\\\"a\\\":1,\\\"b\\\":\\\"b\\\"},{\\\"a\\\":2,\\\"b\\\":\\\"a\\\"},{\\\"a\\\":2,\\\"b\\\":\\\"b\\\"}]\")",
    "AssertEq(ToJson({2, 1} \\X {\"b\", \"a\"}), \"[[1,\\\"a\\\"],[1,\\\"b\\\"],[2,\\\"a\\\"],[2,\\\"b\\\"]]\")",
    "AssertEq(ToJson(SUBSET {2, 1}), \"[[],[1],[2],[1,2]]\")",
    "AssertEq(ToJson(1..3), \"[1,2,3]\")",
    "AssertEq(ToJsonArray({3, 2, 1}), \"[1,2,3]\")",
    "AssertEq(ToJsonArray(<<3, 2, 1>>), \"[3,2,1]\")",
    "AssertEq(ToJsonArray([x \\in {3, 2, 1} |-> 2 * x + 1]), \"[3,5,7]\")",
    "AssertEq(ToJsonArray(3 :> \"c\" @@ 2 :> \"b\" @@ 1 :> \"a\"), \"[\\\"a\\\",\\\"b\\\",\\\"c\\\"]\")",
    "AssertEq(ToJsonArray([ {2, 1} -> {\"a\", \"b\"} ]), \"[[\\\"a\\\",\\\"a\\\"],[\\\"a\\\",\\\"b\\\"],[\\\"b\\\",\\\"a\\\"],[\\\"b\\\",\\\"b\\\"]]\")",
    "AssertEq(ToJsonArray([ {1, 0} -> {\"a\", \"b\"} ]), \"[{\\\"0\\\":\\\"a\\\",\\\"1\\\":\\\"a\\\"},{\\\"0\\\":\\\"a\\\",\\\"1\\\":\\\"b\\\"},{\\\"0\\\":\\\"b\\\",\\\"1\\\":\\\"a\\\"},{\\\"0\\\":\\\"b\\\",\\\"1\\\":\\\"b\\\"}]\")",
    "AssertEq(ToJsonArray([a: {2, 1}, b: {\"a\", \"b\"}]), \"[{\\\"a\\\":1,\\\"b\\\":\\\"a\\\"},{\\\"a\\\":1,\\\"b\\\":\\\"b\\\"},{\\\"a\\\":2,\\\"b\\\":\\\"a\\\"},{\\\"a\\\":2,\\\"b\\\":\\\"b\\\"}]\")",
    "AssertEq(ToJsonArray({2, 1} \\X {\"b\", \"a\"}), \"[[1,\\\"a\\\"],[1,\\\"b\\\"],[2,\\\"a\\\"],[2,\\\"b\\\"]]\")",
    "AssertEq(ToJsonArray(SUBSET {2, 1}), \"[[],[1],[2],[1,2]]\")",
    "AssertEq(ToJsonArray(1..3), \"[1,2,3]\")",
    "AssertEq(ToJsonObject([a |-> FALSE, b |-> 1]), \"{\\\"a\\\":false,\\\"b\\\":1}\")",
    "AssertEq(ToJsonObject(\"a\" :> 1 @@ \"b\" :> 2 @@ \"c\" :> 3), \"{\\\"a\\\":1,\\\"b\\\":2,\\\"c\\\":3}\")",
    "AssertEq(ToJsonObject(1 :> \"b\" @@ 0 :> \"c\"), \"{\\\"0\\\":\\\"c\\\",\\\"1\\\":\\\"b\\\"}\")",
    "AssertEq(ToJsonObject([n \\in 1..2 |-> \"a\"]), \"[\\\"a\\\",\\\"a\\\"]\")",
    "AssertEq(ToJsonObject([a |-> {<<1, 2>>}, b |-> [c |-> 3]]), \"{\\\"a\\\":[[1,2]],\\\"b\\\":{\\\"c\\\":3}}\")",
    "ndTestObjects",
    "ndTestArrays",
    "ndTestPrimitives",
    "TestObjects",
    "TestArrays",
    "TestPrimitives",
    "RoundTrip",
    "RoundTrip2",
    "AssertError(\n           \"The second argument of JsonSerialize should be a sequence or record, but instead it is:\\n{1, 2, 3}\",\n           JsonSerialize(\"target/json/test.json\", {1,2,3} ))",
    "AssertError(\n           \"The second argument of JsonSerialize should be a sequence or record, but instead it is:\\n({\\\"a\\\"} :> 3 @@ {\\\"b\\\"} :> [c |-> <<4, 5, 6>>])\",\n           JsonSerialize(\"target/json/test.json\", [ n \\in {{\"a\"}} |-> 3 ] @@ [ n \\in {{\"b\"}} |-> [c |-> <<4, 5, 6>>]] ))",
    "AssertError(\n           \"The second argument of ndJsonSerialize should be a sequence, but instead it is:\\n[a |-> 1, b |-> TRUE]\",\n           ndJsonSerialize(\"target/json/test.json\", [a |-> 1, b |-> TRUE] ))",
    "AssertError(\n           \"The second argument of JsonSerialize should be a sequence or record, but instead it is:\\n42\",\n           JsonSerialize(\"target/json/test.json\", 42 ))",
    "AssertError(\n           \"The second argument of ndJsonSerialize should be a sequence, but instead it is:\\n42\",\n           ndJsonSerialize(\"target/json/test.json\", 42 ))"
  ],
