  "AssumeProveBlocks": [
    "ASSUME NEW S \\in SUBSET (Ballot \\cup {-1}), IsFiniteSet(S) PROVE IF S = {} THEN MaxBallot(S) = -1 ELSE /\\ MaxBallot(S) \\in S /\\ \\A x \\in S : MaxBallot(S) >= x",
    "SUFFICES ASSUME Inv, [Next]_vars PROVE Inv'",
    "ASSUME NEW self \\in Acceptor, NEW b \\in Ballot, \\/ Phase1b(self, b) \\/ Phase2av(self, b) \\/ Phase2b(self,b) \\/ LearnsSent(self, b) PROVE Inv'",
    "ASSUME NEW self \\in Ballot, \\/ Phase1a(self) \\/ Phase1c(self) PROVE Inv'",
    "ASSUME NEW self \\in FakeAcceptor, FakingAcceptor(self) PROVE Inv'"
