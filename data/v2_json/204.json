    "IF incoming[n] = {} /\\ outgoing[n] = {} THEN \"leader\" ELSE IF incoming[n] = {} THEN \"source\" ELSE IF outgoing[n] = {} THEN \"sink\" ELSE \"internal\"",
    "IF m \\in outgoing[n] THEN mailbox[m] \\cup {downMsg(n,n)} ELSE mailbox[m]",
    "IF m \\in outgoing[n] THEN mailbox[m] \\cup {downMsg(n,min)} ELSE mailbox[m]",
    "IF noSndrs = {} THEN ... ELSE ...",
    "IF m \\in incoming[n] THEN mailbox[m] \\union {upMsg(n, IF m \\in minSndrs THEN \"yes\" ELSE \"no\", (m # keep[valSent(m)]) \\/ isLoneSink)} ELSE IF m = n THEN mailbox[m] \\ (upMsgs \\union downMsgs) ELSE mailbox[m]",
    "IF m \\in minSndrs THEN \"yes\" ELSE \"no\"",
    "IF isLoneSink THEN {} ELSE {keep[min]}",
    "IF m \\in incoming[n] THEN mailbox[m] \\union {upMsg(n, \"no\", m # keep[valSent(m)])} ELSE IF m = n THEN mailbox[m] \\ (upMsgs \\union downMsgs) ELSE mailbox[m]",
    "IF n = Min(Nodes) THEN kind(n) = \"leader\" ELSE ~ active[n]"
