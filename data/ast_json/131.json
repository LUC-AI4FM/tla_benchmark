  "AssumeProveBlocks": [
    "ASSUME NEW v, NEW j \\in Int PROVE  IsFiniteSet(PositionsBefore(v,j))",
    "ASSUME TypeOK, NEW j \\in 1 .. Len(seq), NEW v PROVE  PositionsBefore(v, j+1) =\n         IF seq[j] = v THEN PositionsBefore(v,j) \\union {j}\n         ELSE PositionsBefore(v,j)",
    "ASSUME TypeOK, NEW j \\in 1 .. Len(seq), NEW v PROVE  OccurrencesBefore(v, j+1) =\n         IF seq[j] = v THEN OccurrencesBefore(v,j) + 1\n         ELSE OccurrencesBefore(v,j)\n<1>1. CASE seq[j] = v\n  <2>1. IsFiniteSet(PositionsBefore(v,j))",
    "ASSUME TypeOK, Inv, Next PROVE Inv'",
    "ASSUME NEW v \\in Value \\ {seq[i]} PROVE  2 * OccurrencesBefore(v, i+1) <= (i+1) - 1 - 1",
    "ASSUME NEW v \\in Value \\ {cand'} PROVE  2 * OccurrencesBefore(v, i') <= i' - 1 - cnt'"
  ],
