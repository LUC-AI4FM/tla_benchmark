    "IF initiator THEN \"cand\" ELSE \"lost\"",
    "IF initiator[self] THEN /\\ msgs' = [msgs EXCEPT ![succ(self)] = @ \\cup {Id[self]}] ELSE /\\ TRUE /\\ msgs' = msgs",
    "IF initiator[self] THEN \"cand\" ELSE \"lost\"",
    "IF state[self] = \"lost\" THEN /\\ msgs' = [_msgs EXCEPT ![succ(self)] = @ \\cup {id}] /\\ state' = state ELSE ...",
