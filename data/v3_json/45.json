  "IfThenElse": [
    "IF k # self THEN /\\ pc' = [pc EXCEPT ![self] = \"Li2\"] ELSE /\\ pc' = [pc EXCEPT ![self] = \"Li4a\"]",
    "IF b[temp[self]] THEN /\\ pc' = [pc EXCEPT ![self] = \"Li3c\"] ELSE /\\ pc' = [pc EXCEPT ![self] = \"Li3d\"]",
    "IF temp[self] # {} THEN /\\ \\E j \\in temp[self] : /\\ temp' = [temp EXCEPT ![self] = temp[self] \\ {j}] /\\ IF ~c[j] THEN /\\ pc' = [pc EXCEPT ![self] = \"Li1\"] ELSE /\\ pc' = [pc EXCEPT ![self] = \"Li4b\"] ELSE /\\ pc' = [pc EXCEPT ![self] = \"cs\"] /\\ temp' = temp",
    "IF ~c[j] THEN /\\ pc' = [pc EXCEPT ![self] = \"Li1\"] ELSE /\\ pc' = [pc EXCEPT ![self] = \"Li4b\"]"
