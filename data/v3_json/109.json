  "AssumptionNames": [
    "/\\ TLCGet(\"config\").mode = \"generate\" /\\ (TLCGet(\"config\").depth >= 15 \\/ TLCGet(\"config\").depth = -1) /\\ TLCGet(\"config\").deadlock = FALSE /\\ TLCGet(\"revision\").timestamp >= 1663720820",
    "/\\ CSVRecords(CSVFile) = 0 => CSVWrite(\"side,p,flip\", <<>>, CSVFile) /\\ \\A i \\in Done: TLCSet(atoi(i), 0)"
  ],
