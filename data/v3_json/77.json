  "IfThenElse": [
    "IF color[n] = \"black\" THEN \"black\" ELSE tkn.color (in PassTokenOpts)",
    "IF EWD998!Termination # EWD998!Termination' THEN TLCSet(1, TLCGet(\"level\")) ELSE TRUE (in AtTermination)"
  ],
  "CaseExpr": [
