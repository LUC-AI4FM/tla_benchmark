    "TLCGet(\"config\").depth = -1",
    "TLCGet(\"config\").deadlock = FALSE",
    "TLCGet(\"revision\").timestamp >= 1628119427",
    "F \\subseteq FeatureFlags",
    "TLCSet(1, 0)"
  ],
