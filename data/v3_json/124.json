  "IfThenElse": [
    "IF i > j THEN i ELSE j",
    "IF S = {} THEN 0 ELSE CHOOSE x \\in S : \\A y \\in S : x \\geq y",
    "IF i \\in DOMAIN s THEN s[i] ELSE t[i]",
    "IF \\E lc \\in LC : lc.param = id THEN ... ELSE 3",
    "IF \\E lc \\in ALC : isALC(lc) THEN ... ELSE 0",
    "IF \\E i \\in paramNums : subst.subFor[i] = id THEN ... ELSE {id}",
    "IF \\E i \\in paramNums : subst.subFor[i] = opid THEN ... ELSE opid",
    "IF \\E i \\in 1..Len(subst.subFor) : subst.subFor[i] = alc.param THEN ... ELSE {alc}",
    "IF Node[subst.subWith[subExpNum]].ref \\in OpDeclNodeId THEN ... ELSE {}",
    "IF SubOp(alp.op) \\in OpDeclNodeId THEN ... ELSE {}",
    "IF mparamId[i] \\in subExp.levelParams THEN mexp[i].level ELSE 0",
    "IF param[i] \\in subExp.levelParams THEN 1 ELSE 0",
    "IF op.weights[i] = 1 THEN arg[i].levelParams ELSE { }",
    "IF n.ref \\in OpDeclNodeId \\cup BoundSymbolNodeId THEN ... ELSE ...",
    "IF n.ref \\in ConstantDeclNodeId THEN {n.ref} ELSE { }",
    "IF n.operator \\in OpDeclNodeId THEN DeclaredOpApplNodeLevelCorrect(n) ELSE DefinedOpApplNodeLevelCorrect(n)"
  ],
