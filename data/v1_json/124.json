  "IfThenElse": [
    "IF i > j THEN i ELSE j (in NumMax)",
    "IF S = {} THEN 0 ELSE CHOOSE x \\in S : \\A y \\in S : x \\geq y (in SetMax)",
    "IF i \\in DOMAIN s THEN s[i] ELSE t[i] (in rc)",
    "IF \\E lc \\in LC : lc.param = id THEN ... ELSE 3 (in MinLevelConstraint)",
    "IF \\E lc \\in ALC : isALC(lc) THEN ... ELSE 0 (in minALC)",
    "IF \\E i \\in paramNums : subst.subFor[i] = id THEN ... ELSE {id} (in ParamSubst)",
    "IF \\E i \\in paramNums : subst.subFor[i] = opid THEN ... ELSE opid (in SubOp)",
    "IF \\E i \\in 1..Len(subst.subFor) : subst.subFor[i] = alc.param THEN ... ELSE {alc} (in Sub)",
    "IF Node[subst.subWith[subExpNum]].ref \\in OpDeclNodeId THEN ... ELSE {} (in Sub)",
    "IF SubOp(alp.op) \\in OpDeclNodeId THEN ... ELSE {} (in ALC)",
    "IF SubOp(alp.op) \\in OpDeclNodeId THEN ... ELSE {} (in Sub)",
    "IF mparamId[i] \\in subExp.levelParams THEN mexp[i].level ELSE 0 (in pLevel)",
    "IF param[i] \\in subExp.levelParams THEN 1 ELSE 0 (in weights)",
    "IF op.weights[i] = 1 THEN arg[i].levelParams ELSE { } (in LP)",
    "IF n.ref \\in OpDeclNodeId \\cup BoundSymbolNodeId THEN ... ELSE ... (in IdentifierNodeLevelCorrect)",
    "IF n.operator \\in OpDeclNodeId THEN DeclaredOpApplNodeLevelCorrect(n) ELSE DefinedOpApplNodeLevelCorrect(n) (in OpApplNodeLevelCorrect)"
  ],
