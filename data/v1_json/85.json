{
  "id": 85,
  "Specification": "A script-like TLA+ module designed to orchestrate and automate smoke testing for the EWD998 algorithm. It uses a series of nested assumptions to iterate through various bug flag configurations, executing randomized simulations of the protocol via IOEnvExec and logging any detected invariant or property violations to a CSV file.",
  "ModuleName": "SmokeEWD998_SC",
  "ExtendsModules": [
    "Naturals",
    "TLC",
    "IOUtils",
