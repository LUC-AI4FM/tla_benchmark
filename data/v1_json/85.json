  "VariableNames": [],
  "AssumptionNames": [
    "CSVWrite(\"BugFlags#Violation\", <<>>, CSVFile)",
    "\\A i \\in 1..30 : \\A bf \\in SUBSET (1..6) : Cardinality(bf) # 1 / LET ret == IOEnvExec([BF |-> bf, Out |-> CSVFile, PN |-> RandomElement(3..4)], Cmd) IN /\\ CASE ret.exitValue = 0 -> PrintT(<<JavaTime, bf>>) [] ret.exitValue = 10 -> PrintT(<<bf, \"Assumption violation\">>) [] ret.exitValue = 12 -> PrintT(<<bf, \"Invariant violation (Inv)\">>) [] ret.exitValue = 13 -> PrintT(<<bf, \"Property violation (TDSpec)\">>) [] OTHER -> PrintT(ret) /\\ CSVWrite(\"%1 $s#%2$ s\", <<bf, ret.exitValue>>, CSVFile)"
  ],
