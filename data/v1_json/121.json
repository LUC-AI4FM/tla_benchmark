  "IfThenElse": [
    "IF j < 2 * n THEN /\\ pc' = \"L5\" ELSE /\\ pc' = \"Done\" /\\ UNCHANGED << b, n, f, i, j, k >> (in L3)",
    "IF b[j % n] /= b[(k + i + 1) % n] /\\ i /= nil THEN /\\ pc' = \"L7\" ELSE /\\ pc' = \"L10\" /\\ UNCHANGED << b, n, f, i, j, k >> (in L6)",
    "IF b[j % n] < b[(k + i + 1) % n] THEN /\\ pc' = \"L8\" ELSE /\\ pc' = \"L9\" /\\ UNCHANGED << b, n, f, i, j, k >> (in L7)",
    "IF b[j % n] /= b[(k + i + 1) % n] /\\ i = nil THEN /\\ pc' = \"L11\" ELSE /\\ pc' = \"L14\" /\\ UNCHANGED << b, n, f, i, j, k >> (in L10)",
    "IF b[j % n] < b[(k + i + 1) % n] THEN /\\ pc' = \"L12\" ELSE /\\ pc' = \"L13\" /\\ UNCHANGED << b, n, f, i, j, k >> (in L11)"
  ],
