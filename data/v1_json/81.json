  "VariableNames": [],
  "AssumptionNames": [
    "CSVWrite(\"Variant#Node#Length#T#T2TD#InitiateProbe#PassToken#SendMsg#RecvMsg#Deactivate\", <<>>, CSVFile)",
    "\\A features \\in SUBSET Features: \\A n \\in Nodes: LET ret == IOEnvExec([N |-> n, F |-> features, Out |-> CSVFile], Cmd).exitValue IN CASE ret = 0 -> PrintT(<<JavaTime, n, features>>) [] ret = 10 -> PrintT(<<n, features, \"Assumption violation\">>) [] ret = 12 -> PrintT(<<n, features, \"Safety violation\">>) [] ret = 13 -> PrintT(<<n, features, \"Liveness violation\">>) [] OTHER -> Print(<<n, features, IOEnvExec([N |-> n, F |-> features, Out |-> CSVFile], Cmd), \"Error\">>, FALSE)"
  ],
