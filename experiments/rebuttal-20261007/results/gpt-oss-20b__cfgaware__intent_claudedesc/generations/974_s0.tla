```tla
------------------------------ MODULE SharedReg ------------------------------
EXTENDS Naturals

CONSTANT N

VARIABLES R, T, L, PC

(* ------------------------------------------------------------------------- *)
(*  Type correctness -------------------------------------------------------- *)
(* ------------------------------------------------------------------------- *)

TypeOK == /\ R \in [1..N -> {0,1}]
        /\ T \in [1..N -> BOOLEAN]
        /\ L \in [1..N -> {0,1}]
        /\ PC \in [1..N -> {"Start","Writing","WriteComplete","ReadNeighbor"}]

(* ------------------------------------------------------------------------- *)
(*  Initial state ----------------------------------------------------------- *)
(* ------------------------------------------------------------------------- *)

Init == /\ R = [i \in 1..N |-> 0]
       /\ T = [i \in 1..N |-> FALSE]
       /\ L = [i \in 1..N |-> 0]          (* local registers start at 0   *)
       /\ PC = [i \in 1..N |-> "Start"]

(* ------------------------------------------------------------------------- *)
(*  Helper: left neighbour index ------------------------------------------ *)
(* ------------------------------------------------------------------------- *)

Left(i) == IF i = 1 THEN N ELSE i-1

(* ------------------------------------------------------------------------- *)
(*  Actions for process i --------------------------------------------------- *)
(* ------------------------------------------------------------------------- *)

WriteStart(i) ==
  /\ PC[i] = "Start"
  /\ T[i] = FALSE
  /\ T' = [T EXCEPT ![i] = TRUE]
  /\ R' = R
  /\ L' = L
  /\ PC' = [PC EXCEPT ![i] = "Writing"]

WriteComplete(i) ==
  /\ PC[i] = "Writing"
  /\ T[i] = TRUE
  /\ R' = [R EXCEPT ![i] = 1]
  /\ T' = [T EXCEPT ![i] = FALSE]
  /\ L' = L
  /\ PC' = [PC EXCEPT ![i] = "WriteComplete"]

ReadNeighbor(i) ==
  /\ PC[i] = "WriteComplete"
  /\ j \in 1..N
  /\ j = Left(i)
  /\ val \in {R[j]} UNION (IF T[j] THEN {1} ELSE {})
  /\ L' = [L EXCEPT ![i] = val]
  /\ R' = R
  /\ T' = T
  /\ PC' = [PC EXCEPT ![i] = "ReadNeighbor"]

(* ------------------------------------------------------------------------- *)
(*  Next-state relation ----------------------------------------------------- *)
(* ------------------------------------------------------------------------- *)

Next == \E i \in 1..N :
          (WriteStart(i) \/ WriteComplete(i) \/ ReadNeighbor(i))

Spec == Init /\ [][Next]_<<R,T,L,PC>>

(* ------------------------------------------------------------------------- *)
(*  Safety property -------------------------------------------------------- *)
(* ------------------------------------------------------------------------- *)

Finished == \A i \in 1..N : PC[i] = "ReadNeighbor"

PCorrect == Finished => (\E i \in 1..N : L[i] = 1)

(* ------------------------------------------------------------------------- *)
(*  Inductive invariant ----------------------------------------------------- *)
(* ------------------------------------------------------------------------- *)

Inv ==
  /\ TypeOK
  /\ \A i \in 1..N : (T[i] => R[i] = 0)
  /\ PCorrect

THEOREM Spec => [] Inv
```