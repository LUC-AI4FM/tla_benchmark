------------------------------ MODULE Toggle ------------------------------
EXTENDS Naturals, TLC

VARIABLE s

(*---------------------------------------------------------------------*)
(*  INITIAL STATE                                                      *)
(*---------------------------------------------------------------------*)
Init == s = FALSE

(*---------------------------------------------------------------------*
 *  ACTIONS                                                            *
 *---------------------------------------------------------------------*)
Toggle1 == /\ s' = ~s
Toggle2 == /\ s' = ~s

(*---------------------------------------------------------------------*
 *  NEXT STATE RELATION                                                *
 *---------------------------------------------------------------------*)
Next == Toggle1 \/ Toggle2

(*---------------------------------------------------------------------*
 *  SPECIFICATION (used by TLC)                                       *
 *---------------------------------------------------------------------*)
Spec == Init /\ [][Next]_s

(*---------------------------------------------------------------------*
 *  INVARIANTS (for checking, not required for the configuration)     *
 *---------------------------------------------------------------------*)
BoolInv   == s \in BOOLEAN
FlipInv   == Next => (s' = ~s)

(*---------------------------------------------------------------------*
 *  LIVENESS AND FAIRNESS (to be added to the TLC configuration)      *
 *---------------------------------------------------------------------*)
NoStuck == [] <> Next

(*  In the TLC configuration add:                                      *
 *     WEAK FAIRNESS(Toggle1)                                           *
 *     WEAK FAIRNESS(Toggle2)                                           *)

(*---------------------------------------------------------------------*
 *  CORRECTNESS PROPERTIES (for checking)                              *
 *---------------------------------------------------------------------*)
AltProp      == [](s = FALSE \/ s = TRUE) /\ [] (s' = ~s)
NoFixedPoint == [] <> (s' != s)

=============================================================================