------------------------------ MODULE RegAlg ------------------------------
EXTENDS Naturals, FiniteSets, Sequences, TLC
CONSTANTS N, UNDEF

VARIABLES x, y, pc

(* -------------------------------------------------------------------------- *)
(* Domain predicates and initial state                                         *)
(* -------------------------------------------------------------------------- *)

StatePred ==
  /\ x \in [1..N -> SUBSET {0,1}]
  /\ y \in [1..N -> {UNDEF} ∪ {0,1}]
  /\ pc \in [1..N -> 0..3]

Init ==
  /\ StatePred
  /\ x = [i \in 1..N |-> {0}]
  /\ y = [i \in 1..N |-> UNDEF]
  /\ pc = [i \in 1..N |-> 0]

(* -------------------------------------------------------------------------- *)
(* Actions for each process                                                  *)
(* -------------------------------------------------------------------------- *)

WriteStep1(i) ==
  /\ pc[i] = 0
  /\ x[i] = {0}
  /\ x' = [x EXCEPT ![i] = {0,1}]
  /\ y' = y
  /\ pc' = pc

WriteStep2(i) ==
  /\ pc[i] = 1
  /\ x[i] = {0,1}
  /\ x' = [x EXCEPT ![i] = {1}]
  /\ y' = y
  /\ pc' = pc

ReadNeighbor(i) ==
  /\ pc[i] = 2
  /\ neighbor == IF i < N THEN i+1 ELSE 1
  /\ v \in x[neighbor]
  /\ y' = [y EXCEPT ![i] = v]
  /\ x' = x
  /\ pc' = [pc EXCEPT ![i] = 3]

(* -------------------------------------------------------------------------- *)
(* Next-state relation                                                        *)
(* -------------------------------------------------------------------------- *)

Next ==
  ∃ i ∈ 1..N :
    (WriteStep1(i) \/ WriteStep2(i) \/ ReadNeighbor(i))

(* -------------------------------------------------------------------------- *)
(* Derived predicates                                                         *)
(* -------------------------------------------------------------------------- *)

AllDone ==
  \A i ∈ 1..N : pc[i] = 3

PCorrect ==
  AllDone => \E i ∈ 1..N : y[i] = 1

Inv ==
  /\ StatePred
  /\ \A i ∈ 1..N :
        (pc[i] = 0 ⇒ x[i] = {0}) /\
        (pc[i] = 1 ⇒ x[i] = {0,1} \/ x[i] = {1}) /\
        (pc[i] = 2 ⇒ y[i] = UNDEF) /\
        (pc[i] = 3 ⇒ y[i] ∈ {UNDEF} ∪ {0,1})

(* -------------------------------------------------------------------------- *)
(* Specification                                                              *)
(* -------------------------------------------------------------------------- *)

Spec ==
  Init /\ [][Next]_<<x,y,pc>>

=============================================================================