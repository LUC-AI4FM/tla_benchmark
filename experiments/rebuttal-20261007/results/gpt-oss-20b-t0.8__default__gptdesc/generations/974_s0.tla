MODULE RegularRegisters

EXTENDS Naturals, Sequences, TLC

CONSTANT N

VARIABLES x, pc, y

(* ----------------------------------------------------------------- *)
(*  Auxiliary Definitions                                            *)
(* ----------------------------------------------------------------- *)

Neighbor(i) == IF i = N THEN 1 ELSE i + 1

(* ----------------------------------------------------------------- *)
(*  Initial State                                                    *)
(* ----------------------------------------------------------------- *)

Init ==
  /\ x \in [1..N -> SUBSET {0,1}]
  /\ pc \in [1..N -> {"init","write1","write2","read","done"}]
  /\ y  \in [1..N -> BOOLEAN]
  /\ ∀ i ∈ 1..N : x[i] = {0}
  /\ ∀ i ∈ 1..N : pc[i] = "init"
  /\ ∀ i ∈ 1..N : y[i] = FALSE

(* ----------------------------------------------------------------- *)
(*  Actions                                                          *)
(* ----------------------------------------------------------------- *)

Write1(i) ==
  /\ i \in 1..N
  /\ pc[i] = "init"
  /\ x[i] = {0}
  /\ x' = [x EXCEPT ![i] = {0,1}]
  /\ pc' = [pc EXCEPT ![i] = "write2"]
  /\ y'  = y

Write2(i) ==
  /\ i \in 1..N
  /\ pc[i] = "write2"
  /\ x[i] = {0,1}
  /\ x' = [x EXCEPT ![i] = {1}]
  /\ pc' = [pc EXCEPT ![i] = "read"]
  /\ y'  = y

Read(i) ==
  /\ i \in 1..N
  /\ pc[i] = "read"
  /\ ∃ v ∈ x[Neighbor(i)] :
        /\ y' = [y EXCEPT ![i] = (v = 1)]
        /\ pc' = [pc EXCEPT ![i] = "done"]
        /\ x'  = x

(* ----------------------------------------------------------------- *)
(*  Next State Relation                                              *)
(* ----------------------------------------------------------------- *)

Next == \E i \in 1..N : Write1(i) \/ Write2(i) \/ Read(i)

(* ----------------------------------------------------------------- *)
(*  Termination Condition                                           *)
(* ----------------------------------------------------------------- *)

Termination ==
  ∀ i ∈ 1..N : pc[i] = "done"

(* ----------------------------------------------------------------- *)
(*  Correctness Property                                            *)
(* ----------------------------------------------------------------- *)

PCorrect == Termination => (∃ i ∈ 1..N : y[i] = TRUE)

(* ----------------------------------------------------------------- *)
(*  Inductive Invariant                                             *)
(* ----------------------------------------------------------------- *)

Inv ==
  /\ ∀ i ∈ 1..N : x[i] ⊆ {0,1} /\ x[i] ≠ {}
  /\ ∀ i \in 1..N : pc[i] \in {"init","write1","write2","read","done"}
  /\ ∀ i \in 1..N : y[i] = FALSE \/ y[i] = TRUE
  /\ (Termination => (∃ i ∈ 1..N : y[i] = TRUE))

(* ----------------------------------------------------------------- *)
(*  Specification                                                   *)
(* ----------------------------------------------------------------- *)

Spec == Init /\ [][Next]_<<x,pc,y>> /\ Inv

(* ----------------------------------------------------------------- *)
(*  Safety and Liveness Properties                                   *)
(* ----------------------------------------------------------------- *)

Safety == Inv
Liveness == PCorrect

============================================================================)