------------------------------------------- MODULE FastMutex -------------------------------------------
EXTENDS Naturals, TLC

CONSTANTS M, N   \* 1 <= M < N

VARIABLES owner, x, y, b

(***************************************************************************
 * Initialization
 **************************************************************************)
Init ==
  /\ owner = 0                            \* 0 denotes no process in CS
  /\ x = [i \in 1..N |-> FALSE]
  /\ y = [i \in 1..N |-> FALSE]
  /\ b = FALSE

(***************************************************************************
 * Per‑process actions for class 1 (processes 1..M)
 **************************************************************************)
Class1(i) ==
  \/ (* Entry *)
     /\ x[i]' = TRUE
     /\ owner' = i
     /\ UNCHANGED <<y,b>>
  \/ (* Exit *)
     /\ x[i]' = FALSE
     /\ owner' = 0
     /\ UNCHANGED <<y,b>>

(***************************************************************************
 * Per‑process actions for class 2 (processes M+1..N)
 **************************************************************************)
Class2(j) ==
  \/ (* Entry *)
     /\ y[j]' = TRUE
     /\ owner' = j
     /\ UNCHANGED <<x,b>>
  \/ (* Exit *)
     /\ y[j]' = FALSE
     /\ owner' = 0
     /\ UNCHANGED <<x,b>>

(***************************************************************************
 * Next‑state relation
 **************************************************************************)
Next ==
  \E i \in 1..M : Class1(i)
  \/ \E j \in M+1..N : Class2(j)

(***************************************************************************
 * Auxiliary predicates
 **************************************************************************)
InCS(i) == owner = i

(***************************************************************************
 * Safety invariant: no two distinct processes in the CS simultaneously
 **************************************************************************)
MutualExclusion ==
  \A i, j \in 1..N :
    i # j
    => NOT ( InCS(i) /\ InCS(j) )

(***************************************************************************
 * Liveness property: some process enters the CS infinitely often
 **************************************************************************)
Liveness == [] <> (\E i \in 1..N : InCS(i))

(***************************************************************************
 * Full specification with weak fairness for each process class
 **************************************************************************)
Spec ==
  Init
  /\ [][Next]_<<owner,x,y,b>>
  /\ WF_0 (\E i \in 1..M : Class1(i))
  /\ WF_0 (\E j \in M+1..N : Class2(j))

=============================================================================