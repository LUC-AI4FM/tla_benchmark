---- MODULE InitStates ----
EXTENDS Naturals

VARIABLE x

vars == <<x>>

(***************************************************************************)
(* Several candidate initial predicates over x.  They differ only in the   *)
(* syntactic shape of the disjunction.  TLC computes initial states by     *)
(* exploring the disjuncts of the initial predicate one after another, so  *)
(* the shape of the formula decides whether the same state is produced     *)
(* more than once.                                                         *)
(***************************************************************************)

(* Disjunction at top level with overlapping disjuncts.  TLC handles each  *)
(* disjunct on its own and generates x = 1 twice (TLC removes the copy     *)
(* through its fingerprint set, but the generated-states count includes    *)
(* it).                                                                    *)
Init1 == \/ x \in {0, 1}
         \/ x \in {1, 2}

(* Disjunction placed inside a conjunction, after the conjunct that         *)
(* assigns x.  x is already bound when the disjunction is evaluated, so the *)
(* disjunction is only a boolean test and no duplicate is generated.       *)
Init2 == /\ x \in {0, 1, 2}
         /\ \/ x \in {0, 1}
            \/ x \in {1, 2}

(* Same conjuncts in the opposite order.  The disjunction now comes first  *)
(* and each of its branches assigns x, so x = 1 is generated twice.        *)
Init3 == /\ \/ x \in {0, 1}
            \/ x \in {1, 2}
         /\ x \in {0, 1, 2}

(* Double negation around the disjunction.  TLC does not split a negated    *)
(* formula into separate disjuncts. It evaluates it as a boolean, so x has  *)
(* to be bound first.  With the assignment first, no duplicates are        *)
(* generated.                                                              *)
Init4 == /\ x \in {0, 1, 2}
         /\ ~~(\/ x \in {0, 1}
               \/ x \in {1, 2})

(* Overlapping disjuncts that each give an explicit equality.  x = 1 is     *)
(* generated by both branches.                                              *)
Init5 == \/ x = 0
         \/ x = 1
         \/ x = 1
         \/ x = 2

(* The initial predicate chosen for model checking.  It produces duplicate *)
(* initial states from the top-level disjunction.                          *)
Init == Init1

(* The behavior relation is trivial.  x never changes.                     *)
Next == UNCHANGED x

Spec == Init /\ [][Next]_vars

TypeOK == x \in {0, 1, 2}

====