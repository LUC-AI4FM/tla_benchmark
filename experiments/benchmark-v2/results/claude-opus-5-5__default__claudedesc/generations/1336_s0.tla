------------------------------- MODULE MCEcho -------------------------------
(***************************************************************************)
(* Model-checking configuration for the Echo algorithm specified in the    *)
(* parent module Echo. It instantiates a small test case with three nodes, *)
(* an arbitrarily chosen initiator, and a fully connected network that is  *)
(* symmetric and irreflexive.                                              *)
(*                                                                         *)
(* Corresponding .cfg settings:                                            *)
(*   CONSTANTS  Node <- N1   initiator <- I1   R <- R1   NoNode = NoNode   *)
(*   SPECIFICATION SpecWithPrint                                           *)
(*   INVARIANTS TypeOK AncestorProperties                                  *)
(*   VIEW View                                                             *)
(*   POSTCONDITION PostCondition                                           *)
(***************************************************************************)
EXTENDS Echo, TLC

(***************************************************************************)
(* The set of nodes used for model checking.                               *)
(***************************************************************************)
N1 == {"a", "b", "c"}

(***************************************************************************)
(* The initiator is an arbitrary node of N1.                               *)
(***************************************************************************)
I1 == CHOOSE n \in N1 : TRUE

(***************************************************************************)
(* Fully connected mesh: an edge between every pair of distinct nodes,     *)
(* no self-loops.                                                          *)
(***************************************************************************)
R1 == [ edge \in N1 \X N1 |-> IF edge[1] = edge[2] THEN FALSE ELSE TRUE ]

(***************************************************************************)
(* Alternative definition: any graph over N1 that is connected, symmetric  *)
(* and irreflexive.                                                        *)
(***************************************************************************)
R1Alt == CHOOSE r \in [N1 \X N1 -> BOOLEAN] :
            /\ IsConnected(r, N1)
            /\ IsSymmetric(r, N1)
            /\ IsIrreflexive(r, N1)

(***************************************************************************)
(* Wrap the main specification so that the graph relation is printed at    *)
(* startup for debugging purposes.                                         *)
(***************************************************************************)
InitWithPrint == PrintT(<<"R", R>>) /\ Init

SpecWithPrint == InitWithPrint /\ [][Next]_vars

(***************************************************************************)
(* View used for state-space reduction.                                    *)
(***************************************************************************)
View == <<inbox, parent, reached>>

(***************************************************************************)
(* Postcondition recording the number of states generated by TLC.          *)
(***************************************************************************)
PostCondition ==
    PrintT(<<"generated", TLCGet("stats").generated>>)

(***************************************************************************)
(* Invariants checked (defined in Echo): TypeOK, AncestorProperties.       *)
(***************************************************************************)
MCTypeOK == TypeOK
MCAncestorProperties == AncestorProperties

=============================================================================