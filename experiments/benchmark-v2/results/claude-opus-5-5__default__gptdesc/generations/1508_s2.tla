---------------------------- MODULE SmallStateMachine ----------------------------
EXTENDS Naturals

VARIABLES x

vars == << x >>

MyNat == 0..30

TypeOK == x \in MyNat

Init == x = 0

(***************************************************************************)
(* Action A: increment x by 1, staying within MyNat.                       *)
(***************************************************************************)
A == /\ x + 1 \in MyNat
     /\ x' = x + 1

(***************************************************************************)
(* Action BandC: disjunction of two sub-actions B and C.                   *)
(***************************************************************************)
B == /\ x + 2 \in MyNat
     /\ x' = x + 2

C == /\ x > 0
     /\ x' = x - 1

BandC == B \/ C

(***************************************************************************)
(* Action DandE: disjunction of two sub-actions D and E.                   *)
(***************************************************************************)
D == /\ x * 2 \in MyNat
     /\ x' = x * 2

E == /\ x >= 3
     /\ x' = x - 3

DandE == D \/ E

Next == A \/ BandC \/ DandE

(***************************************************************************)
(* Inv: the state predicate used in Spec (initial condition / invariant).  *)
(***************************************************************************)
Inv == /\ Init
       /\ TypeOK

Spec == Inv /\ [][Next]_x

(***************************************************************************)
(* Safety property: x always remains in MyNat.                             *)
(***************************************************************************)
TypeInvariant == []TypeOK

THEOREM Spec => []TypeOK
=============================================================================