---------------------------- MODULE InitDisjunctions ----------------------------
(***************************************************************************)
(* A small TLC-oriented specification exploring how TLC generates initial  *)
(* states from different syntactic shapes of disjunctive initial           *)
(* predicates over a single variable x.  The next-state relation is        *)
(* trivial (x never changes), so the interest lies entirely in the         *)
(* structure of the initial predicates.                                    *)
(***************************************************************************)
EXTENDS Naturals

VARIABLE x

vars == << x >>

(***************************************************************************)
(* Init1: A plain disjunction whose disjuncts each assign x a distinct     *)
(* value.  TLC enumerates each disjunct separately, producing the states   *)
(* x = 1 and x = 2 without duplicates.                                     *)
(***************************************************************************)
Init1 == \/ x = 1
         \/ x = 2

(***************************************************************************)
(* Init2: Overlapping disjuncts.  Both disjuncts can produce x = 1.  TLC   *)
(* evaluates each disjunct independently, so it generates the state       *)
(* x = 1 twice (it is a duplicate; TLC reports distinct states only once   *)
(* but the "states generated" count includes the duplicate).              *)
(***************************************************************************)
Init2 == \/ x = 1
         \/ x \in {1, 2}

(***************************************************************************)
(* Init3: The assignment conjunct comes first and the disjunction acts as  *)
(* a filter afterwards.  Since x is already bound when the disjunction is  *)
(* evaluated, the disjunction is merely tested as a boolean, so no         *)
(* duplicate initial states are generated: x = 1 and x = 2 once each.      *)
(***************************************************************************)
Init3 == /\ x \in {1, 2, 3}
         /\ \/ x = 1
            \/ x \in {1, 2}

(***************************************************************************)
(* Init4: Same conjuncts as Init3 but in the opposite order.  Now the      *)
(* disjunction is evaluated while x is still unbound, so each disjunct     *)
(* acts as an assignment.  The state x = 1 is generated by both            *)
(* disjuncts, so TLC SHOULD generate a duplicate initial state here.       *)
(***************************************************************************)
Init4 == /\ \/ x = 1
            \/ x \in {1, 2}
         /\ x \in {1, 2, 3}

(***************************************************************************)
(* Init5: Disjunction placed outside of the conjunction.  Each disjunct is *)
(* a full conjunction that assigns x.  Overlap between disjuncts yields    *)
(* a duplicate for x = 1.                                                  *)
(***************************************************************************)
Init5 == \/ /\ x \in {1, 2}
            /\ x # 3
         \/ /\ x = 1
            /\ TRUE

(***************************************************************************)
(* Init6: Double negation of a disjunction.  TLC cannot use a negated      *)
(* formula to assign a value to x, so the assignment must happen in a      *)
(* preceding conjunct; the double-negated disjunction is then evaluated   *)
(* as a boolean test and therefore generates NO duplicate states.         *)
(***************************************************************************)
Init6 == /\ x \in {1, 2, 3}
         /\ ~~(\/ x = 1
               \/ x \in {1, 2})

(***************************************************************************)
(* Init7: Disjunction expressed through negation of a conjunction (De     *)
(* Morgan form) after x has been bound: again a pure filter, so no         *)
(* duplicates are generated.                                               *)
(***************************************************************************)
Init7 == /\ x \in {1, 2, 3}
         /\ ~(/\ x # 1
              /\ x \notin {1, 2})

(***************************************************************************)
(* The initial predicate used by Spec.  Change to any of Init1..Init7 to  *)
(* observe TLC's initial-state generation behaviour.                       *)
(***************************************************************************)
Init == Init4

(***************************************************************************)
(* Trivial next-state relation: x never changes.                           *)
(***************************************************************************)
Next == UNCHANGED x

Spec == Init /\ [][Next]_vars

(***************************************************************************)
(* Sanity invariants.                                                      *)
(***************************************************************************)
TypeOK == x \in {1, 2, 3}

InitValuesOK == x \in {1, 2}

(* All candidate initial predicates (except Init1 vs. the others' filters) *)
(* describe the same set of states {1, 2}.                                 *)
THEOREM InitsEquivalent ==
    /\ Init1 <=> Init2
    /\ Init2 <=> Init3
    /\ Init3 <=> Init4
    /\ Init4 <=> Init5
    /\ Init5 <=> Init6
    /\ Init6 <=> Init7

THEOREM Spec => []TypeOK
THEOREM Spec => []InitValuesOK
=============================================================================